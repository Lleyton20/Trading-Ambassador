# Copy this file to .env and fill in real values.
# Every setting here has a safe default in app/config.py, so the app runs
# with NO .env file at all for local development — this file only matters
# once you need to override a default (e.g. switch to Postgres).

# --- Database ---------------------------------------------------------
# Leave unset to use the local SQLite file (./trading_ambassador.db).
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/trading_ambassador

# --- Trading day / sessions --------------------------------------------
# TRADING_DAY_TIMEZONE=America/New_York
# TRADING_DAY_ROLLOVER_HOUR=17

# --- SMC engine tuning ---------------------------------------------------
# SWING_LOOKBACK=2
# MIN_DISPLACEMENT_ATR_MULT=1.5
# LIQUIDITY_TOLERANCE_PCT=0.0005

# --- Risk engine ----------------------------------------------------------
# MIN_ACCEPTABLE_RR=2.0
# DEFAULT_RISK_PER_TRADE_PCT=1.0

# --- Future: real broker/data provider credentials go here once a live
# MarketDataProvider is added (see app/market_data/base.py). Never commit
# real values — this file is tracked in git, .env is not (see .gitignore).
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
# DERIV_API_TOKEN=
