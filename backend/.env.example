# Copy this file to .env and fill in real values.
# Every setting here has a safe default in app/config.py, so the app runs
# with NO .env file at all for local development — this file only matters
# once you need to override a default (e.g. switch to Postgres).

# --- Database ---------------------------------------------------------
# Leave unset to use the local SQLite file (./trading_ambassador.db).
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/trading_ambassador

# --- Trading day / sessions --------------------------------------------
# TRADING_DAY_TIMEZONE=America/New_York
# TRADING_DAY_ROLLOVER_HOUR=17

# --- SMC engine tuning ---------------------------------------------------
# SWING_LOOKBACK=2
# MIN_DISPLACEMENT_ATR_MULT=1.5
# LIQUIDITY_TOLERANCE_PCT=0.0005

# --- Risk engine ----------------------------------------------------------
# MIN_ACCEPTABLE_RR=2.0
# DEFAULT_RISK_PER_TRADE_PCT=1.0

# --- Market data provider ----------------------------------------------
# "mock" (default) uses the deterministic dev fixture, no setup required.
# "deriv" uses live data from Deriv's public WebSocket API — covers both
# Forex majors and the synthetic indices from one connection, and needs no
# API token (only an app_id) for market data. See
# app/market_data/deriv_provider.py.
# MARKET_DATA_PROVIDER=deriv
# DERIV_APP_ID=1089
# DERIV_REQUEST_TIMEOUT=10.0

# Not used by Milestone 3 (market data needs no auth) — reserved for a
# later milestone that places real orders or reads account-specific data.
# Never commit a real value — this file is tracked in git, .env is not.
# DERIV_API_TOKEN=

# --- News / economic calendar (Finnhub) ---------------------------------
# Free API key from https://finnhub.io. Without it, GET /api/news/calendar
# returns {"available": false, ...} instead of erroring - see
# app/news/finnhub_client.py.
# FINNHUB_API_KEY=
# NEWS_LOOKAHEAD_DAYS=7

# --- Price-in-zone alerts + Telegram -------------------------------------
# Off by default. Turning this on starts a background loop (interval
# below) that checks every instrument's current price against unmitigated
# order blocks/FVGs and fires an alert (DB row + Telegram message) on a
# fresh zone entry. See app/alerts/watcher.py.
# ALERTS_ENABLED=true
# ALERTS_TIMEFRAME=H1
# ALERTS_POLL_INTERVAL_SECONDS=60
#
# From @BotFather in Telegram (bot token), and the chat to post into
# (message your bot once, then GET https://api.telegram.org/bot<token>/getUpdates
# to find your chat ID). Never commit real values.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
